# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI Provider Configuration (Centralized AI Manager)
# Supported Providers: gemini | openrouter | huggingface | custom
VITE_AI_PROVIDER="gemini"
VITE_AI_MODEL="gemini-flash-latest"

# Fallback AI Provider Configuration (Automatic Failover)
VITE_AI_FALLBACK_PROVIDER="gemini"
VITE_AI_FALLBACK_MODEL="gemini-3.8-flash"

# Optional Third-Party Provider Keys (Kept strictly server-side / environment)
OPENROUTER_API_KEY=""
HUGGINGFACE_API_KEY=""
VITE_AI_BASE_URL=""
VITE_AI_API_KEY=""

# GOOGLE_MAPS_API_KEY: Optional. For live Google Places & Maps API calls.
# If not provided, HeritageAI smoothly utilizes high-fidelity verified demo data with clear demo markers.
GOOGLE_MAPS_API_KEY=""

# VoxCPM2 Text-to-Speech (TTS) Provider Configuration
# Official Model ID: openbmb/VoxCPM2 (Apache 2.0 license)
# 2B Parameter Multilingual Tokenizer-Free Diffusion TTS Model (48kHz audio)
VITE_TTS_PROVIDER="voxcpm2"
VITE_TTS_API_URL=""
VITE_TTS_API_KEY=""

# Firebase Configuration (Optional if using Cloud Firestore / Auth)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

