rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTrustedAdmin() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'btin2499@gmail.com';
    }

    function hasNoPasswordField(data) {
      return !data.keys().hasAny(['password', 'passwordHash', 'credential', 'credentials']);
    }

    function isAllowedMemberRole(role) {
      return role in ['user', 'student', 'researcher'];
    }

    // User documents are keyed by Firebase Authentication UID.
    // Passwords and authentication credentials must never be stored here.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isTrustedAdmin());

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && hasNoPasswordField(request.resource.data)
        && (
          isAllowedMemberRole(request.resource.data.role)
          || (isTrustedAdmin() && request.resource.data.role == 'admin')
        );

      allow update: if isAuthenticated()
        && (isTrustedAdmin() || request.auth.uid == userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && hasNoPasswordField(request.resource.data)
        && (
          isTrustedAdmin()
          || (
            isAllowedMemberRole(resource.data.role)
            && request.resource.data.role == resource.data.role
          )
        );

      allow delete: if isTrustedAdmin();
    }

    // Legacy account documents are intentionally blocked. Authentication
    // records belong in Firebase Authentication, not a readable collection.
    match /accounts/{accountId} {
      allow read, write: if false;
    }

    // Public cultural reference data; only verified admins can change it.
    match /heritage/{heritageId} {
      allow read: if true;
      allow write: if isTrustedAdmin();
    }

    // Family stories are private unless explicitly published as public.
    match /familyStories/{storyId} {
      allow read: if resource.data.visibility == 'public'
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || isTrustedAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && (
          isTrustedAdmin()
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
          )
        );

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isTrustedAdmin());
    }

    // Community members may submit posts, but cannot approve their own posts.
    match /communityPosts/{postId} {
      allow read: if resource.data.status == 'approved'
        || (isAuthenticated() && resource.data.userId == request.auth.uid)
        || isTrustedAdmin();

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isTrustedAdmin()
        || (
          isAuthenticated()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isTrustedAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /itineraries/{itineraryId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isTrustedAdmin());

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && (
          isTrustedAdmin()
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
          )
        );
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isTrustedAdmin());
    }

    match /favorites/{favoriteId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isTrustedAdmin());

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated()
        && (
          isTrustedAdmin()
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
          )
        );
      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isTrustedAdmin());
    }

    // Safe, non-secret AI/TTS settings can be read by the app.
    // API keys, private keys and credentials must stay in server environment variables.
    match /system_config_public/{configId} {
      allow read: if true;
      allow write: if isTrustedAdmin();
    }

    // Never expose secret-bearing legacy config documents to ordinary clients.
    match /system_config/{configId} {
      allow read, write: if isTrustedAdmin();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
